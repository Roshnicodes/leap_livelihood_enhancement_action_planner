<% content_for :title, "Achievement Entry | LEAP" %>
<% achievement_column = "#{@selected_month}_t" %>

<section class="page-header achievement-header">
  <div>
    <p class="eyebrow">FCO Workspace</p>
    <h1>Achievement Entry</h1>
    <p class="muted">Select TO, project and month to update field achievements against action plan targets.</p>
  </div>
  <div class="header-card">
    <span>FCO</span>
    <strong><%= @fco_display_mappings.size %></strong>
  </div>
</section>

<section class="achievement-context">
  <% @fco_display_mappings.each do |mapping| %>
    <article>
      <span>Mapped FCO</span>
      <strong><%= mapping[:fco_name] %></strong>
      <small>ID <%= mapping[:fco_id] %></small>
    </article>
  <% end %>
</section>

<% if @open_returned_submissions.present? %>
  <section class="table-panel achievement-return-panel">
    <div class="table-heading">
      <div>
        <p class="eyebrow">Returned</p>
        <h2>Returned Achievement Requests</h2>
        <p class="muted">Open the request, update achievement details, then submit again.</p>
      </div>
      <span class="status-badge status-returned"><%= @open_returned_submissions.size %> open</span>
    </div>
    <div class="responsive-table">
      <table>
        <thead>
          <tr>
            <th>Project</th>
            <th>FCO / TO</th>
            <th>Vertical</th>
            <th>Month</th>
            <th>Returned By</th>
            <th>Return Remark</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @open_returned_submissions.each do |submission| %>
            <tr>
              <td><strong><%= submission.project_name %></strong></td>
              <td>
                <strong><%= ActionPlanFcoGroup.name_for(submission.fco_id, submission.fco_name) %></strong>
                <div class="muted">FCO ID: <%= ActionPlanFcoGroup.display_id_for(submission.fco_id) %></div>
                <div><%= [submission.to_name, submission.to_id].compact_blank.join(" / ") %></div>
              </td>
              <td>
                <span class="code-pill"><%= submission.state_code %> / <%= submission.theme_label %></span>
              </td>
              <td><span class="code-pill"><%= submission.month.capitalize %></span></td>
              <td>
                <strong><%= submission.returned_by&.name || submission.returned_stage.to_s.titleize %></strong>
                <% if submission.returned_at.present? %>
                  <div class="muted"><%= format_record_datetime(submission.returned_at) %></div>
                <% end %>
              </td>
              <td class="achievement-return-remark"><%= simple_format(submission.returned_remark.presence || "-", class: "muted") %></td>
              <td>
                <%= link_to "Open Entry",
                  achievement_entry_path(to_id: submission.to_id, project: submission.project_name, month: submission.month),
                  class: "approval-review-button achievement-open-return-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<section class="toolbar achievement-toolbar records-filter-toolbar">
  <%= form_with url: achievement_entry_path,
        method: :get,
        local: true,
        class: "achievement-filter-form",
        html: { autocomplete: "off", "data-achievement-filters": true } do |form| %>
    <label>
      <span class="filter-label">Choose TO</span>
      <%= form.select :to_id,
        options_for_select(@to_options, @selected_to_id.to_s),
        { prompt: "Select TO" },
        class: "select",
        autocomplete: "off",
        data: { filter: "to" } %>
    </label>

    <label>
      <span class="filter-label">Choose Project</span>
      <%= form.select :project,
        options_for_select(@project_options.map { |project| [project, project] }, @selected_project.to_s),
        { prompt: "Select Project" },
        class: "select",
        autocomplete: "off",
        data: { filter: "project" } %>
    </label>

    <label>
      <span class="filter-label">Choose Month</span>
      <%= form.select :month,
        options_for_select(@month_options, @selected_month.to_s),
        { prompt: "Select Month" },
        class: "select",
        autocomplete: "off",
        data: { filter: "month" } %>
    </label>
  <% end %>
  <% if @rows.present? %>
    <div class="toolbar-actions">
      <%= link_to "Download Excel Sheet", achievement_entry_path(request.query_parameters.merge(format: :xlsx)), class: "secondary-button" %>
    </div>
  <% end %>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-achievement-filters]");
    if (!form) return;

    const toSelect = form.querySelector('[data-filter="to"]');
    const projectSelect = form.querySelector('[data-filter="project"]');
    const monthSelect = form.querySelector('[data-filter="month"]');

    function submitFilters() {
      form.submit();
    }

    toSelect?.addEventListener("change", () => {
      // Changing TO should reset project/month so old values don't stick.
      if (projectSelect) projectSelect.value = "";
      if (monthSelect) monthSelect.value = "";
      submitFilters();
    });

    projectSelect?.addEventListener("change", () => {
      if (monthSelect) monthSelect.value = "";
      submitFilters();
    });

    monthSelect?.addEventListener("change", submitFilters);
  })();
</script>

<% if @rows.present? %>
  <%= form_with url: achievement_entry_path,
        method: :patch,
        class: "table-panel achievement-entry-panel",
        html: { multipart: true } do %>
    <%= hidden_field_tag :to_id, @selected_to_id %>
    <%= hidden_field_tag :project, @selected_project %>
    <%= hidden_field_tag :month, @selected_month %>

    <div class="table-heading">
      <div>
        <p class="eyebrow">Achievement Entry</p>
        <h2><%= @selected_project %> • <%= @selected_month.capitalize %></h2>
        <p class="muted">
          <%= @to_options.assoc(@selected_to_id)&.first %>
          • Total Activity Target: <strong><%= @target_rows_count %></strong>
          <% if @selected_returned_submissions.present? %>
            • Returned for correction
          <% elsif @locked_submission_count.to_i.positive? && @submission_candidate_row_count.to_i.zero? %>
            • Locked after vertical approval
          <% elsif @active_submission_count.to_i.positive? %>
            • Submitted for approval
          <% end %>
        </p>
        <p class="achievement-legend">
          <span class="achievement-legend-dot"></span>
          Highlighted activities have a target greater than 0
        </p>
      </div>
      <div class="table-actions">
        <input type="search" class="table-search" placeholder="Search activities" data-table-search-input>
        <span class="table-count" data-filtered-count data-count-label="activities"><%= @rows.size %> activities</span>
      </div>
    </div>

    <% if @selected_returned_submissions.present? %>
      <div class="achievement-return-alert">
        <div class="achievement-return-alert-heading">
          <span class="status-badge status-returned">Returned</span>
          <div>
            <strong>Correction Required</strong>
            <p class="muted">Update the returned achievement details and submit again.</p>
          </div>
        </div>
        <div class="achievement-return-alert-list">
          <% @selected_returned_submissions.each do |submission| %>
            <article>
              <strong>
                <%= submission.returned_by&.name || submission.returned_stage.to_s.titleize %>
                <% if submission.returned_at.present? %>
                  • <%= format_record_datetime(submission.returned_at) %>
                <% end %>
              </strong>
              <p><%= submission.state_code %> / <%= submission.theme_label %></p>
              <%= simple_format(submission.returned_remark.presence || "-", class: "achievement-return-note") %>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="responsive-table achievement-table-wrap" data-searchable-table>
      <table class="action-plan-table achievement-entry-table">
        <thead>
          <tr>
            <th>S.No.</th>
            <th>Project</th>
            <th>TO</th>
            <th>ASA Theme ID / ASA Theme</th>
            <th>ASA Activity ID / ASA Activity</th>
            <th>Project Activity</th>
            <th>Unit</th>
            <th><%= @selected_month.capitalize %> Target</th>
            <th><%= @selected_month.capitalize %> Achievement</th>
            <th>Means of Verification</th>
            <th>Remark</th>
          </tr>
        </thead>
        <tbody>
          <% locked_row_ids = @locked_submission_row_ids || [] %>
          <% @rows.each_with_index do |row, index| %>
            <% month_target = row.public_send(@selected_month).to_i %>
            <% has_target = month_target.positive? %>
            <% detail = @entry_details_by_row_id[row.id] %>
            <% row_locked = locked_row_ids.include?(row.id) %>
            <tr class="<%= "achievement-row-has-target" if has_target %>">
              <td><span class="code-pill"><%= index + 1 %></span></td>
              <td><strong><%= row.project_name %></strong></td>
              <td>
                <span class="code-pill"><%= row.to_id %></span>
                <div><%= row.to_name %></div>
              </td>
              <td>
                <span class="code-pill"><%= action_plan_cell(row.asa_theme_id, decimal: true) %></span>
                <div><%= row.asa_theme %></div>
              </td>
              <td>
                <span class="code-pill"><%= action_plan_cell(row.asa_activity_id, decimal: true) %></span>
                <div><%= row.asa_activity_name %></div>
              </td>
              <td><%= row.activity.presence || row.activity_id.presence || "-" %></td>
              <td><%= row.unit_type.presence || "-" %></td>
              <td class="achievement-target-cell <%= "has-target" if has_target %>">
                <span class="achievement-target-pill" <%= raw('style="color:#ffffff;-webkit-text-fill-color:#ffffff;"') if has_target %>><%= whole_number(month_target) %></span>
              </td>
              <td class="achievement-input-cell <%= "has-target" if has_target %>">
                <%= number_field_tag "achievements[#{row.id}]",
                  row.public_send(achievement_column),
                  min: 0,
                  step: 1,
                  class: "achievement-input #{'is-priority' if has_target}",
                  disabled: row_locked,
                  aria: { label: "#{@selected_month.capitalize} achievement for #{row.asa_activity_name.presence || row.activity}" } %>
              </td>
              <td class="achievement-file-cell">
                <div class="achievement-file-stack" data-file-stack>
                  <% if detail&.files&.attached? %>
                    <%= render "shared/attachment_previews",
                      attachments: detail.files.attachments,
                      removable: !row_locked %>
                  <% end %>
                  <div class="achievement-local-previews" data-local-file-previews></div>
                  <%= file_field_tag "files[#{row.id}][]",
                    multiple: true,
                    disabled: row_locked,
                    class: "achievement-file-input",
                    data: { local_file_input: true },
                    aria: { label: "Upload supporting files for #{row.asa_activity_name.presence || row.activity}" } %>
                  <small class="muted">Any file type • preview on select • Save Draft to keep • max 10 / 50 MB</small>
                </div>
              </td>
              <td class="achievement-remark-cell">
                <%= text_area_tag "remarks[#{row.id}]",
                  detail&.remark,
                  rows: 2,
                  class: "achievement-remark-input",
                  disabled: row_locked,
                  placeholder: "Remark",
                  aria: { label: "Remark for #{row.asa_activity_name.presence || row.activity}" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="submit-panel achievement-submit-panel">
      <p class="muted">
        <% if @selected_returned_submissions.present? && @submission_candidate_row_count.to_i.positive? %>
          This request was returned. Update values, remarks or files, then submit again.
        <% elsif @locked_submission_count.to_i.positive? && @editable_row_count.to_i.zero? %>
          Vertical approval is done. Achievements are locked for this month.
        <% elsif @active_submission_count.to_i.positive? %>
          Already submitted for approval. Changes are allowed only until vertical approval.
        <% else %>
          Save as draft, or submit for approval when ready.
        <% end %>
      </p>
      <div class="achievement-submit-actions">
        <%= text_field_tag :submission_remark, nil, class: "remark-input achievement-submit-remark", placeholder: "Remark for approvers (optional)", disabled: @submission_candidate_row_count.to_i.zero? %>
        <%= submit_tag "Save Draft", class: "secondary-button", disabled: @editable_row_count.to_i.zero? %>
        <%= submit_tag "Submit for Approval",
          class: "submit-plan-button",
          disabled: @submission_candidate_row_count.to_i.zero? %>
      </div>
    </div>
  <% end %>
<% else %>
  <section class="empty-state">
    <% if @selected_to_id.blank? %>
      <h2>Select TO</h2>
      <p class="muted">Choose a TO first, then project and month.</p>
    <% elsif @selected_project.blank? %>
      <h2>Select Project</h2>
      <p class="muted">Choose a project for the selected TO.</p>
    <% elsif @selected_month.blank? %>
      <h2>Select Month</h2>
      <p class="muted">Choose a month to view and enter achievements.</p>
    <% else %>
      <h2>No activities found</h2>
      <p class="muted">No activities found for this TO, project and month.</p>
    <% end %>
  </section>
<% end %>
