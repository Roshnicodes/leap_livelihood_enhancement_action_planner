<% content_for :title, "Achievement Entry | LEAP" %>
<% achievement_column = "#{@selected_month}_t" %>

<section class="page-header achievement-header">
  <div>
    <p class="eyebrow"><%= current_user.admin? ? "MIS Workspace" : "FCO Workspace" %></p>
    <h1>Achievement Entry</h1>
    <p class="muted">
      <% if current_user.admin? %>
        Select FCO, TO, project and month to correct achievement entries.
      <% else %>
        Select TO, project and month to update field achievements against action plan targets.
      <% end %>
    </p>
  </div>
  <div class="header-card">
    <span>FCO</span>
    <strong><%= current_user.admin? ? (@selected_fco_id.present? ? 1 : @fco_options.size) : @fco_display_mappings.size %></strong>
  </div>
</section>

<% if @fco_display_mappings.present? %>
  <section class="achievement-context">
    <% @fco_display_mappings.each do |mapping| %>
      <article>
        <span><%= current_user.admin? ? "Selected FCO" : "Mapped FCO" %></span>
        <strong><%= mapping[:fco_name] %></strong>
        <small>ID <%= mapping[:fco_id] %></small>
      </article>
    <% end %>
  </section>
<% end %>

<% if @open_returned_submissions.present? %>
  <section class="table-panel achievement-return-panel">
    <div class="table-heading">
      <div>
        <p class="eyebrow">Returned</p>
        <h2>Returned Achievement Requests</h2>
        <p class="muted">Open the request, update achievement details, then submit again.</p>
      </div>
      <span class="status-badge status-returned"><%= @open_returned_submissions.size %> open</span>
    </div>
    <div class="responsive-table">
      <table>
        <thead>
          <tr>
            <th>Project</th>
            <th>FCO / TO</th>
            <th>Vertical</th>
            <th>Month</th>
            <th>Returned By</th>
            <th>Return Remark</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @open_returned_submissions.each do |submission| %>
            <% modal_id = "achievement-return-entry-#{submission.id}" %>
            <tr>
              <td><strong><%= submission.project_name %></strong></td>
              <td>
                <strong><%= ActionPlanFcoGroup.name_for(submission.fco_id, submission.fco_name) %></strong>
                <div class="muted">FCO ID: <%= ActionPlanFcoGroup.display_id_for(submission.fco_id) %></div>
                <div><%= [submission.to_name, submission.to_id].compact_blank.join(" / ") %></div>
              </td>
              <td>
                <span class="code-pill"><%= submission.state_code %> / <%= submission.theme_label %></span>
              </td>
              <td><span class="code-pill"><%= submission.month.capitalize %></span></td>
              <td>
                <strong><%= submission.returned_by&.name || submission.returned_stage.to_s.titleize %></strong>
                <% if submission.returned_at.present? %>
                  <div class="muted"><%= format_record_datetime(submission.returned_at) %></div>
                <% end %>
              </td>
              <td class="achievement-return-remark"><%= simple_format(submission.returned_remark.presence || "-", class: "muted") %></td>
              <td>
                <%= link_to "Open Entry",
                  achievement_entry_path({ to_id: submission.to_id, project: submission.project_name, month: submission.month }.merge(current_user.admin? ? { fco_id: @selected_fco_id } : {})),
                  class: "approval-review-button achievement-open-return-link",
                  data: { open_returned_achievement_modal: modal_id } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <% @open_returned_submissions.each do |submission| %>
    <% context = @returned_entry_contexts[submission.id] %>
    <% next if context.blank? || context[:rows].blank? %>
    <% modal_id = "achievement-return-entry-#{submission.id}" %>
    <section id="<%= modal_id %>" class="activity-modal is-hidden achievement-return-entry-modal" data-returned-achievement-modal aria-hidden="true">
      <div class="activity-modal-backdrop" data-close-returned-achievement-modal></div>
      <div class="activity-modal-panel achievement-return-entry-panel" role="dialog" aria-modal="true" aria-labelledby="<%= modal_id %>-title">
        <div class="activity-modal-heading">
          <div>
            <p class="eyebrow">Returned Achievement</p>
            <h2 id="<%= modal_id %>-title"><%= submission.project_name %></h2>
            <p class="muted"><%= ActionPlanFcoGroup.name_for(submission.fco_id, submission.fco_name) %> • <%= submission.to_name %> • <%= submission.month.capitalize %></p>
          </div>
          <button type="button" class="modal-close-button" data-close-returned-achievement-modal aria-label="Close entry">×</button>
        </div>
        <div class="achievement-return-entry-body">
          <%= render "entry_form",
            rows: context[:rows],
            selected_to_id: context[:selected_to_id],
            selected_to_label: context[:selected_to_label],
            selected_project: context[:selected_project],
            selected_month: context[:selected_month],
            target_rows_count: context[:target_rows_count],
            entry_details_by_row_id: context[:entry_details_by_row_id],
            locked_submission_row_ids: context[:locked_submission_row_ids],
            editable_row_count: context[:editable_row_count],
            submission_candidate_row_count: context[:submission_candidate_row_count],
            locked_submission_count: context[:locked_submission_count],
            active_submission_count: context[:active_submission_count],
            selected_returned_submissions: context[:selected_returned_submissions],
            selected_fco_id: @selected_fco_id,
            mode_label: current_user.admin? ? "MIS Excel Edit" : "Achievement Entry",
            save_label: current_user.admin? ? "Save Changes" : "Save Draft",
            submit_label: "Submit for Approval",
            form_class: "achievement-entry-panel achievement-return-modal-form",
            form_id: "achievement-return-form-#{submission.id}",
            field_id_prefix: "achievement_return_#{submission.id}" %>
        </div>
      </div>
    </section>
  <% end %>

  <script>
    (() => {
      function closeReturnedAchievementModals() {
        document.querySelectorAll("[data-returned-achievement-modal]").forEach((modal) => {
          modal.classList.add("is-hidden");
          modal.setAttribute("aria-hidden", "true");
        });
      }

      document.querySelectorAll("[data-open-returned-achievement-modal]").forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          const modal = document.getElementById(trigger.dataset.openReturnedAchievementModal);
          if (!modal) return;

          event.preventDefault();
          closeReturnedAchievementModals();
          modal.classList.remove("is-hidden");
          modal.setAttribute("aria-hidden", "false");
          modal.querySelector("input:not([type='hidden']):not([disabled]), textarea:not([disabled]), button:not([disabled])")?.focus({ preventScroll: true });
        });
      });

      document.querySelectorAll("[data-close-returned-achievement-modal]").forEach((trigger) => {
        trigger.addEventListener("click", closeReturnedAchievementModals);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeReturnedAchievementModals();
      });
    })();
  </script>
<% end %>

<section class="toolbar achievement-toolbar records-filter-toolbar">
  <%= form_with url: achievement_entry_path,
        method: :get,
        local: true,
        class: "achievement-filter-form",
        html: { autocomplete: "off", "data-achievement-filters": true } do |form| %>
    <% if current_user.admin? %>
      <label>
        <span class="filter-label">Choose Project</span>
        <%= form.select :project,
          options_for_select(@project_options.map { |project| [project, project] }, @selected_project.to_s),
          { prompt: "Select Project" },
          class: "select",
          autocomplete: "off",
          data: { filter: "project" } %>
      </label>

      <label>
        <span class="filter-label">Choose FCO</span>
        <%= form.select :fco_id,
          options_for_select(@fco_options, @selected_fco_id.to_s),
          { prompt: "Select FCO" },
          class: "select",
          autocomplete: "off",
          data: { filter: "fco" } %>
      </label>
    <% end %>

    <label>
      <span class="filter-label">Choose TO</span>
      <%= form.select :to_id,
        options_for_select(@to_options, @selected_to_id.to_s),
        { prompt: "Select TO" },
        class: "select",
        autocomplete: "off",
        data: { filter: "to" } %>
    </label>

    <% unless current_user.admin? %>
      <label>
        <span class="filter-label">Choose Project</span>
        <%= form.select :project,
          options_for_select(@project_options.map { |project| [project, project] }, @selected_project.to_s),
          { prompt: "Select Project" },
          class: "select",
          autocomplete: "off",
          data: { filter: "project" } %>
      </label>
    <% end %>

    <label>
      <span class="filter-label">Choose Month</span>
      <%= form.select :month,
        options_for_select(@month_options, @selected_month.to_s),
        { prompt: "Select Month" },
        class: "select",
        autocomplete: "off",
        data: { filter: "month" } %>
    </label>
  <% end %>
  <% if @rows.present? %>
    <div class="toolbar-actions">
      <%= link_to current_user.admin? ? "Download Excel Format" : "Download Excel Sheet",
        achievement_entry_path(request.query_parameters.merge(format: :xlsx)),
        class: "secondary-button" %>
      <% if current_user.admin? %>
        <%= form_with url: import_excel_achievement_entry_path,
          method: :post,
          local: true,
          html: { multipart: true },
          class: "achievement-excel-upload-form" do %>
          <%= hidden_field_tag :fco_id, @selected_fco_id %>
          <%= hidden_field_tag :to_id, @selected_to_id %>
          <%= hidden_field_tag :project, @selected_project %>
          <%= hidden_field_tag :month, @selected_month %>
          <label>
            <span class="filter-label">Upload Edited Excel</span>
            <%= file_field_tag :achievement_excel_file,
              accept: ".xlsx,.csv",
              class: "input achievement-excel-file-input" %>
          </label>
          <%= submit_tag "Upload Excel", class: "secondary-button" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<script>
  (() => {
    const form = document.querySelector("[data-achievement-filters]");
    if (!form) return;

    const fcoSelect = form.querySelector('[data-filter="fco"]');
    const toSelect = form.querySelector('[data-filter="to"]');
    const projectSelect = form.querySelector('[data-filter="project"]');
    const monthSelect = form.querySelector('[data-filter="month"]');
    const adminEntry = <%= current_user.admin? ? "true" : "false" %>;

    function submitFilters() {
      form.submit();
    }

    fcoSelect?.addEventListener("change", () => {
      if (toSelect) toSelect.value = "";
      if (monthSelect) monthSelect.value = "";
      submitFilters();
    });

    toSelect?.addEventListener("change", () => {
      // Changing TO should reset project/month so old values don't stick.
      if (!adminEntry && projectSelect) projectSelect.value = "";
      if (monthSelect) monthSelect.value = "";
      submitFilters();
    });

    projectSelect?.addEventListener("change", () => {
      if (adminEntry && toSelect) toSelect.value = "";
      if (monthSelect) monthSelect.value = "";
      submitFilters();
    });

    monthSelect?.addEventListener("change", submitFilters);
  })();
</script>

<% if @rows.present? %>
  <%= render "entry_form",
    rows: @rows,
    selected_to_id: @selected_to_id,
    selected_to_label: @to_options.assoc(@selected_to_id)&.first,
    selected_project: @selected_project,
    selected_month: @selected_month,
    target_rows_count: @target_rows_count,
    entry_details_by_row_id: @entry_details_by_row_id,
    locked_submission_row_ids: @locked_submission_row_ids,
    editable_row_count: @editable_row_count,
    submission_candidate_row_count: @submission_candidate_row_count,
    locked_submission_count: @locked_submission_count,
    active_submission_count: @active_submission_count,
    selected_returned_submissions: @selected_returned_submissions,
    selected_fco_id: @selected_fco_id,
    mode_label: current_user.admin? ? "MIS Excel Edit" : "Achievement Entry",
    save_label: current_user.admin? ? "Save Changes" : "Save Draft",
    submit_label: "Submit for Approval",
    form_class: "table-panel achievement-entry-panel#{' achievement-excel-edit-panel' if current_user.admin?}",
    field_id_prefix: "achievement_entry_page" %>
<% else %>
  <section class="empty-state">
    <% if current_user.admin? && @selected_fco_id.blank? %>
      <h2>Select FCO</h2>
      <p class="muted">Choose an FCO first, then TO, project and month.</p>
    <% elsif @selected_to_id.blank? %>
      <h2>Select TO</h2>
      <p class="muted">Choose a TO first, then project and month.</p>
    <% elsif @selected_project.blank? %>
      <h2>Select Project</h2>
      <p class="muted">Choose a project for the selected TO.</p>
    <% elsif @selected_month.blank? %>
      <h2>Select Month</h2>
      <p class="muted">Choose a month to view and enter achievements.</p>
    <% else %>
      <h2>No activities found</h2>
      <p class="muted">No activities found for this TO, project and month.</p>
    <% end %>
  </section>
<% end %>
