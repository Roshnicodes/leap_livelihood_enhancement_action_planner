<% content_for :title, "FCO Access Mapping | LEAP" %>
<% editing_mapping = @mapping_form.persisted? %>
<% mapping_form_url = editing_mapping ? admin_update_action_plan_fco_mapping_path(@mapping_form) : admin_action_plan_fco_mapping_path %>
<% mapping_form_method = editing_mapping ? :patch : :post %>

<section class="page-header admin-hero">
  <div>
    <p class="eyebrow">MIS workspace</p>
    <h1>FCO Access</h1>
  </div>
  <div class="header-card">
    <span>Mapped Employees</span>
    <strong><%= @mapped_employees.size %></strong>
  </div>
</section>

<section class="metric-grid metric-grid-compact">
  <article class="metric metric-teal"><span>Available FCO</span><strong><%= @fco_options.size %></strong></article>
  <article class="metric metric-blue"><span>Mapped Employees</span><strong><%= @mapped_employees.size %></strong></article>
  <article class="metric metric-gold"><span>Active Mappings</span><strong><%= @active_mapping_rows.size %></strong></article>
  <article class="metric metric-rose"><span>Disabled</span><strong><%= @disabled_mapping_rows.size %></strong></article>
</section>

<% transfer_options = @fco_transfer_options.map do |fco|
  [ "#{fco[:fco_name]} (ID: #{fco[:fco_id]} • #{fco[:project_count]} projects • #{fco[:row_count]} rows)", fco[:fco_id] ]
end %>
<section class="table-panel fco-transfer-panel">
  <div class="table-heading">
    <div>
      <p class="eyebrow">Safe data management</p>
      <h2>Merge FCO data</h2>
      <p class="muted">Moves only current Action Plan rows and active month changes to the target FCO. Historical achievement submissions remain unchanged and are retained in the target FCO reports. Every transfer has an undo option.</p>
    </div>
  </div>

  <%= form_with url: admin_transfer_action_plan_fco_mapping_path, method: :post, class: "admin-master-form fco-transfer-form" do |form| %>
    <div class="admin-form-grid fco-transfer-grid">
      <label>
        <span>Source FCO</span>
        <%= form.select :source_fco_id, options_for_select(transfer_options), { include_blank: "Select FCO to merge" }, class: "select", required: true %>
      </label>
      <label>
        <span>Target FCO</span>
        <%= form.select :target_fco_id, options_for_select(transfer_options), { include_blank: "Select receiving FCO" }, class: "select", required: true %>
      </label>
      <label>
        <span>Reason / note</span>
        <%= form.text_field :transfer_note, class: "input", placeholder: "e.g. Kukshi merged into Jobat" %>
      </label>
      <label>
        <span>Type MERGE to confirm</span>
        <%= form.text_field :transfer_confirmation, class: "input", autocomplete: "off", required: true %>
      </label>
    </div>
    <div class="admin-form-footer">
      <%= form.submit "Merge into Target FCO", class: "return-button", data: { turbo_confirm: "This will reassign the selected FCO's current action-plan data. Historical achievement submissions will be kept. Continue?" } %>
    </div>
  <% end %>
</section>

<section class="table-panel admin-data-panel fco-transfer-history" data-searchable-table>
  <div class="table-heading">
    <div>
      <h2>Transfer history</h2>
    </div>
    <div class="table-actions">
      <input type="search" class="table-search" placeholder="Search FCO transfers" data-table-search-input>
      <span class="table-count" data-filtered-count data-count-label="transfers"><%= @fco_transfers.size %> transfers</span>
    </div>
  </div>
  <div class="responsive-table">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Status</th>
          <th>Source</th>
          <th>Target</th>
          <th>Moved Data</th>
          <th>Done By</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @fco_transfers.each do |transfer| %>
          <tr class="<%= "is-disabled-row" unless transfer.active? %>">
            <td><span class="status-badge status-<%= transfer.active? ? "pending" : "not_submitted" %>"><%= transfer.active? ? "Active" : "Reverted" %></span></td>
            <td><strong><%= transfer.source_fco_name %></strong><div class="muted">ID: <%= transfer.source_fco_id %></div></td>
            <td><strong><%= transfer.target_fco_name %></strong><div class="muted">ID: <%= transfer.target_fco_id %></div></td>
            <td>
              <strong><%= pluralize(transfer.action_plan_row_count, "action-plan row") %></strong>
              <div class="muted"><%= pluralize(transfer.project_count, "project") %> · <%= pluralize(transfer.month_change_count, "active month change") %></div>
              <% if transfer.note.present? %><div class="muted"><%= transfer.note %></div><% end %>
            </td>
            <td><%= transfer.transferred_by&.login || "-" %><div class="muted"><%= transfer.created_at.in_time_zone("Asia/Kolkata").strftime("%d %b %Y, %I:%M %p") %></div></td>
            <td>
              <% if transfer.active? %>
                <%= button_to "Undo Transfer",
                  admin_revert_action_plan_fco_transfer_path(transfer),
                  method: :patch,
                  class: "secondary-button admin-row-button",
                  form: { data: { turbo_confirm: "Undo this FCO transfer? Only the rows recorded in this transfer will be restored to #{transfer.source_fco_name}." } } %>
              <% else %>
                <span class="muted">Reverted by <%= transfer.reverted_by&.login || "-" %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @fco_transfers.empty? %>
          <tr><td colspan="6" class="muted">No FCO data transfers have been made.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="table-panel admin-editor-panel">
  <div class="table-heading">
    <div>
      <h2><%= editing_mapping ? "Edit access" : "Add access" %></h2>
    </div>
    <div class="table-actions">
      <% if editing_mapping %>
        <%= link_to "Add New", admin_action_plan_fco_mapping_path(employee_id: @selected_employee&.id), class: "secondary-button" %>
      <% end %>
      <%= link_to "Download", admin_action_plan_fco_mapping_path(format: :xlsx), class: "approval-review-button" %>
    </div>
  </div>

  <%= form_with model: @mapping_form, url: mapping_form_url, method: mapping_form_method, class: "admin-master-form fco-admin-form" do |form| %>
    <div class="admin-form-grid fco-form-grid">
      <label>
        <span>Employee</span>
        <%= form.select :employee_id,
          options_from_collection_for_select(@employees, :id, ->(employee) { "#{employee.employee_code} - #{employee.name}" }, @mapping_form.employee_id || @selected_employee&.id),
          {},
          class: "select",
          required: true %>
      </label>
      <label>
        <span>FCO ID</span>
        <%= form.text_field :fco_id, class: "input", list: "fco-id-options", required: true %>
      </label>
      <label>
        <span>FCO Name</span>
        <%= form.text_field :fco_name, class: "input" %>
      </label>
    </div>
    <datalist id="fco-id-options">
      <% @fco_options.each do |fco| %>
        <option value="<%= fco[:fco_id] %>"><%= fco[:fco_name] %></option>
      <% end %>
    </datalist>
    <div class="admin-form-footer">
      <%= form.submit editing_mapping ? "Update Access" : "Add Access", class: "submit-plan-button" %>
    </div>
  <% end %>
</section>

<% if @selected_employee %>
  <section class="table-panel admin-editor-panel">
    <div class="table-heading">
      <div>
        <h2>Manage access</h2>
      </div>
      <div class="table-actions">
        <span class="table-count"><%= @selected_fco_ids.size %> mapped</span>
      </div>
    </div>

    <%= form_with url: admin_action_plan_fco_mapping_path, method: :get, class: "admin-master-form fco-employee-picker-form" do |form| %>
      <div class="admin-form-grid fco-employee-picker-grid">
        <label>
          <span>Employee</span>
          <%= form.select :employee_id,
            options_from_collection_for_select(@employees, :id, ->(employee) { "#{employee.employee_code} - #{employee.name}" }, @selected_employee.id),
            {},
            class: "select",
            onchange: "this.form.requestSubmit()" %>
        </label>
      </div>
    <% end %>

    <%= form_with url: admin_action_plan_fco_mapping_path, method: :patch, class: "admin-master-form" do %>
      <%= hidden_field_tag :employee_id, @selected_employee.id %>
      <div class="fco-checkbox-grid">
        <% @fco_options.each do |fco| %>
          <label class="fco-check-card">
            <%= check_box_tag "fco_ids[]", fco[:fco_id], @selected_fco_ids.include?(fco[:fco_id]), id: "fco_id_#{fco[:fco_id]}" %>
            <span>
              <strong><%= fco[:fco_name] %></strong>
              <small><%= fco[:fco_id] %></small>
            </span>
          </label>
        <% end %>
      </div>
      <div class="admin-form-footer">
        <%= submit_tag "Save Access", class: "submit-plan-button" %>
      </div>
    <% end %>
  </section>
<% end %>

<section class="table-panel compact-upload-panel">
  <div class="table-heading">
    <div>
      <h2>Import Mapping</h2>
    </div>
  </div>

  <%= form_with url: admin_import_action_plan_fco_mapping_path, method: :post, multipart: true, class: "admin-master-form fco-import-form" do |form| %>
    <div class="admin-form-grid fco-import-grid">
      <label>
        <span>FCO mapping file</span>
        <%= form.file_field :mapping_file, accept: ".csv,.xlsx", class: "input" %>
      </label>
      <%= form.submit "Import", class: "submit-plan-button" %>
    </div>
  <% end %>
</section>

<section class="table-panel admin-data-panel" data-searchable-table>
  <div class="table-heading">
    <div>
      <h2>Access List</h2>
    </div>
    <div class="table-actions">
      <input type="search" class="table-search" placeholder="Search access" data-table-search-input>
      <span class="table-count" data-filtered-count data-count-label="mappings"><%= @mapping_rows.size %> mappings</span>
    </div>
  </div>

  <div class="responsive-table">
    <table class="admin-table fco-access-table">
      <thead>
        <tr>
          <th>Status</th>
          <th>Employee</th>
          <th>FCO</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @mapping_rows.each do |mapping| %>
          <tr class="<%= "is-disabled-row" unless mapping.active? %>">
            <td><span class="status-badge status-<%= mapping.active? ? "approved" : "not_submitted" %>"><%= mapping.active? ? "Active" : "Disabled" %></span></td>
            <td>
              <strong><%= mapping.employee&.name || "Not found" %></strong>
              <div class="muted"><%= mapping.employee_code %></div>
            </td>
            <td>
              <strong><%= mapping.fco_name %></strong>
              <div class="muted"><%= mapping.fco_id %></div>
            </td>
            <td>
              <div class="row-action-group">
                <%= link_to "Edit",
                  admin_action_plan_fco_mapping_path(employee_id: mapping.employee_id, edit_mapping_id: mapping.id),
                  class: "secondary-button admin-row-button" %>
                <%= button_to mapping.active? ? "Disable" : "Enable",
                  admin_toggle_action_plan_fco_mapping_path(mapping),
                  method: :patch,
                  class: mapping.active? ? "return-button admin-row-button" : "submit-plan-button admin-row-button",
                  form: { data: { turbo_confirm: "#{mapping.active? ? "Disable" : "Enable"} #{mapping.fco_name} access?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
