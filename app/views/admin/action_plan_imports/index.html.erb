<% content_for :title, "Action Plan Import | LEAP" %>

<section class="page-header">
  <div>
    <p class="eyebrow">PMC workspace</p>
    <h1>Action Plan Import</h1>
    <p class="muted">Upload project ownership and action plan files. Action plan uploads keep old imports archived and show the latest active file.</p>
  </div>
  <div class="header-card">
    <span>Projects</span>
    <strong><%= @summary[:projects] %></strong>
  </div>
</section>

<section class="metric-grid admin-grid">
  <article class="metric metric-teal"><span>Project Owners</span><strong><%= @summary[:project_ownerships] %></strong></article>
  <article class="metric metric-blue"><span>No of Activity</span><strong><%= @summary[:action_plan_rows] %></strong></article>
  <article class="metric metric-gold"><span>User Verticals</span><strong><%= @summary[:vertical_mappings] %></strong></article>
  <article class="metric metric-rose"><span>Archived Activities</span><strong><%= @summary[:archived_action_plan_rows] %></strong></article>
</section>

<section class="table-panel import-panel">
  <div class="table-heading">
    <div>
      <h2>Upload files</h2>
      <p class="muted">Project file can be XLSX/CSV. Project BLI mapping uses only Sheet 1. User vertical mapping filters by State and ASA Theme ID.</p>
    </div>
    <div class="table-actions">
      <%= link_to "Download Action Plan", download_admin_action_plan_imports_path, class: "submit-plan-button" %>
    </div>
  </div>

  <%= form_with url: admin_action_plan_imports_path, method: :post, multipart: true, class: "import-form" do |form| %>
    <div class="import-grid">
      <label>
        <span>Project owner file</span>
        <%= form.file_field :project_file, accept: ".xlsx,.csv", class: "input" %>
      </label>
      <label>
        <span>Project BLI mapping file</span>
        <%= form.file_field :action_plan_file, accept: ".csv,.xlsx", class: "input" %>
      </label>
      <label>
        <span>User vertical mapping file</span>
        <%= form.file_field :vertical_mapping_file, accept: ".csv,.xlsx", class: "input" %>
      </label>
    </div>
    <div class="submit-panel">
      <p>
        Latest action plan import:
        <strong><%= @latest_action_plan_imported_at&.strftime("%d %b %Y %I:%M %p") || "Not imported yet" %></strong>
      </p>
      <%= form.submit "Import Action Plan", class: "submit-plan-button" %>
    </div>
  <% end %>
</section>

<section class="table-panel import-history-panel" data-searchable-table>
  <div class="table-heading">
    <div>
      <h2>Import history</h2>
      <p class="muted">Original uploaded files are saved before import. Download any old file from here.</p>
    </div>
    <div class="table-actions">
      <input type="search" class="table-search" placeholder="Search imports" data-table-search-input>
      <span class="table-count" data-filtered-count><%= @import_files.size %> files</span>
    </div>
  </div>

  <div class="responsive-table">
    <table>
      <thead>
        <tr>
          <th>File Type</th>
          <th>File Name</th>
          <th>Uploaded By</th>
          <th>No of Activity</th>
          <th>Status</th>
          <th>Uploaded At</th>
          <th>Download</th>
        </tr>
      </thead>
      <tbody>
        <% if @import_files.any? %>
          <% @import_files.each do |import_file| %>
            <tr>
              <td><span class="code-pill"><%= import_file.type_label %></span></td>
              <td>
                <strong><%= import_file.original_filename %></strong>
                <div class="muted"><%= number_to_human_size(import_file.byte_size) %></div>
                <% if import_file.error_message.present? %>
                  <div class="import-error"><%= import_file.error_message %></div>
                <% end %>
              </td>
              <td><%= import_file.uploaded_by&.admin? ? "PMC" : import_file.uploaded_by&.employee&.name || "-" %></td>
              <td><%= import_file.row_count || "-" %></td>
              <td><span class="status-badge status-<%= import_file.status == "failed" ? "returned" : "approved" %>"><%= import_file.status.titleize %></span></td>
              <td><%= import_file.imported_at.strftime("%d %b %Y %I:%M %p") %></td>
              <td>
                <% if import_file.file_available? %>
                  <%= link_to "Download", download_file_admin_action_plan_import_path(import_file), class: "approval-review-button" %>
                <% else %>
                  <span class="status-badge status-not_submitted">Missing</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7">No saved import files yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="table-panel" data-searchable-table>
  <div class="table-heading">
    <div>
      <h2>User vertical mapping table</h2>
      <p class="muted">Fixed database mapping used by Vertical Action Plan.</p>
    </div>
    <div class="table-actions">
      <input type="search" class="table-search" placeholder="Search user verticals" data-table-search-input>
      <span class="table-count" data-filtered-count data-count-label="activities"><%= @vertical_mappings.size %> activities</span>
    </div>
  </div>

  <div class="responsive-table">
    <table>
      <thead>
        <tr>
          <th>Employee ID</th>
          <th>Employee Name</th>
          <th>State</th>
          <th>ASA Theme ID</th>
          <th>ASA Theme</th>
          <th>Login</th>
        </tr>
      </thead>
      <tbody>
        <% @vertical_mappings.each do |mapping| %>
          <tr>
            <td><span class="code-pill"><%= mapping.employee_code %></span></td>
            <td><%= mapping.employee&.name || "Not found" %></td>
            <td><span class="code-pill"><%= mapping.state_code %></span></td>
            <td><span class="code-pill"><%= mapping.asa_theme_id %></span></td>
            <td><%= mapping.asa_theme %></td>
            <td>
              <% if mapping.employee %>
                <span class="status-badge status-<%= mapping.employee.active? ? "approved" : "not_submitted" %>"><%= mapping.employee.active? ? "Active" : "Inactive" %></span>
              <% else %>
                <span class="status-badge status-not_submitted">No employee</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="table-panel" data-searchable-table>
  <div class="table-heading">
    <div>
      <h2>Project owner table</h2>
      <p class="muted">Imported from the project file.</p>
    </div>
    <div class="table-actions">
      <input type="search" class="table-search" placeholder="Search project owners" data-table-search-input>
      <span class="table-count" data-filtered-count data-count-label="activities"><%= @project_ownerships.size %> activities</span>
    </div>
  </div>

  <div class="responsive-table">
    <table>
      <thead>
        <tr>
          <th>PO ID</th>
          <th>Project</th>
          <th>Project Owner ID</th>
          <th>Project Owner</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        <% @project_ownerships.each do |ownership| %>
          <tr>
            <td><span class="code-pill"><%= ownership.po_id %></span></td>
            <td><%= ownership.project_name %></td>
            <td><%= ownership.project_owner_id %></td>
            <td><%= ownership.po_name %></td>
            <td><%= ownership.email_id %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
