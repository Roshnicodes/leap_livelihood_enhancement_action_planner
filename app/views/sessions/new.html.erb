<% content_for :title, "Login | LEAP Planner" %>

<section class="login-screen">
  <div class="login-orbit login-orbit-one"></div>
  <div class="login-orbit login-orbit-two"></div>
  <div class="login-panel">
    <div class="login-copy">
      <div class="login-logo">
        <span class="brand-mark">L</span>
        <span>LEAP Planner</span>
      </div>
      <p class="eyebrow">ASA livelihood operations</p>
      <h1>Employee activity planning, mapped clearly.</h1>
      <p class="muted">Admins can review employee master data and activity mappings. Users can sign in with their employee code to view assigned projects and action plans.</p>
      <div class="login-stats">
        <div><strong>Role</strong><span>Admin / User</span></div>
        <div><strong>Menu</strong><span>Project PNB / Action Plan</span></div>
        <div><strong>Data</strong><span>BLI mapped</span></div>
      </div>
    </div>

    <div class="login-card">
      <div class="login-card-head">
        <span class="lock-badge">ID</span>
        <div>
          <h2>Welcome Back</h2>
          <p>Sign in to continue</p>
        </div>
      </div>
      <%= form_with url: login_path, class: "form-stack" do |form| %>
        <label>
          <span>Employee ID or admin email</span>
          <%= form.text_field :login, autofocus: true, placeholder: "1167", class: "input" %>
        </label>
        <label>
          <span>Password</span>
          <%= form.password_field :password, placeholder: "Password", class: "input" %>
        </label>
        <%= form.submit "Login", class: "primary-button" %>
      <% end %>
      <div class="credential-card">
        <strong>Demo credentials</strong>
        <span>Admin: admin@leap.local / admin123</span>
        <span>User: employee code / same code</span>
      </div>
    </div>
  </div>
</section>
