<section id="file-preview-modal" class="file-preview-modal is-hidden" data-file-preview-modal aria-hidden="true">
  <div class="file-preview-backdrop" data-close-file-preview></div>
  <div class="file-preview-panel" role="dialog" aria-modal="true" aria-labelledby="file-preview-title">
    <div class="file-preview-heading">
      <strong id="file-preview-title" data-file-preview-title>File preview</strong>
      <div class="file-preview-heading-actions">
        <a href="#" class="achievement-file-action" data-file-preview-download target="_blank" rel="noopener">Download</a>
        <button type="button" class="modal-close-button" data-close-file-preview aria-label="Close preview">×</button>
      </div>
    </div>
    <div class="file-preview-body" data-file-preview-body></div>
  </div>
</section>
