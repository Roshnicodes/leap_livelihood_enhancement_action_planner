<section class="submission-status-card">
  <span class="status-badge status-<%= action_plan_status_state(submission) %>">
    <%= action_plan_status_badge_label(submission) %>
  </span>
  <div>
    <strong><%= action_plan_approval_headline(submission) %></strong>

    <% if action_plan_approval_subline(submission).present? %>
      <p><%= action_plan_approval_subline(submission) %></p>
    <% end %>

    <p>
      Submitted <%= format_record_datetime(submission.submitted_at) %>
      <% if action_plan_last_reviewed_at(submission).present? %>
        • Reviewed <%= format_record_datetime(action_plan_last_reviewed_at(submission)) %>
      <% end %>
    </p>

    <% if submission.submission_remark.present? %>
      <p>Remark: <%= submission.submission_remark %></p>
    <% end %>

    <% if action_plan_last_review_remark(submission).present? %>
      <p>Approver remark: <%= action_plan_last_review_remark(submission) %></p>
    <% end %>
  </div>
</section>
