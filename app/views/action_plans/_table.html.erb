<% display_columns = ActionPlanRow.display_columns(admin: show_admin_columns) %>
<% project_ownership_lookup = local_assigns.fetch(:project_ownership_lookup, {}) || {} %>

<table class="action-plan-table">
  <thead>
    <tr>
      <% display_columns.each do |column| %>
        <th><%= column[:header] %></th>
      <% end %>
      <% ActionPlanRow::MONTH_DISPLAY_PAIRS.each do |pair| %>
        <th class="month-col"><%= month_column_header(pair[:month_label], "Target") %></th>
        <% if show_achievement %>
          <th class="month-col"><%= month_column_header(pair[:month_label], "Achievement") %></th>
        <% end %>
      <% end %>
      <th class="month-col total-col"><%= month_column_header("Total", "Target") %></th>
      <% if show_achievement %>
        <th class="month-col total-col"><%= month_column_header("Total", "Achievement") %></th>
      <% end %>
      <% if editable_targets %>
        <th>Status</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr data-plan-row data-planned-total="<%= row.planned_total %>">
        <% row_project_ownership = if show_admin_columns
          project_ownership_lookup["po_project:#{row.po_id}:#{ProjectOwnership.normalize_project_key(row.project_name)}"] ||
            project_ownership_lookup["po:#{row.po_id}"] ||
            project_ownership_lookup["project:#{ProjectOwnership.normalize_project_key(row.project_name)}"]
        end %>
        <% display_columns.each do |column| %>
          <td>
            <% cell_value = if show_admin_columns && column[:attribute] == :project_owner
              [row_project_ownership&.po_name, row_project_ownership&.project_owner_id].compact_blank.join(" / ").presence || row.project_owner
            else
              row.public_send(column[:attribute])
            end %>
            <%= action_plan_cell(
              cell_value,
              pill: ActionPlanRow::PILL_ATTRIBUTES.include?(column[:attribute]),
              decimal: ActionPlanRow::DECIMAL_ATTRIBUTES.include?(column[:attribute])
            ) %>
          </td>
        <% end %>
        <% ActionPlanRow::MONTH_DISPLAY_PAIRS.each do |pair| %>
          <td class="month-col">
            <% if editable_targets %>
              <%= number_field_tag "rows[#{row.id}][#{pair[:target_column]}]", row.public_send(pair[:target_column]), min: 0, step: 1, class: "action-plan-month-input", data: { target_input: true }, aria: { label: "#{pair[:target_label]} for #{row.activity}" } %>
            <% else %>
              <%= row.public_send(pair[:target_column]) %>
            <% end %>
          </td>
          <% if show_achievement %>
            <td class="month-col"><%= row.public_send(pair[:achievement_column]) %></td>
          <% end %>
        <% end %>
        <td class="month-col total-col">
          <strong data-row-total><%= row.monthly_total %></strong>
        </td>
        <% if show_achievement %>
          <td class="month-col total-col"><strong><%= row.target_total %></strong></td>
        <% end %>
        <% if editable_targets %>
          <td>
            <span class="summary-status <%= row.balanced? ? "is-balanced" : "is-warning" %>" data-row-status>
              <%= row.balanced? ? "Matched" : "Diff #{signed_number(row.monthly_total - row.planned_total)}" %>
            </span>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
