<% submit_with_targets = local_assigns.fetch(:submit_with_targets, false) %>
<% fco_options = local_assigns.fetch(:fco_options, []) %>
<% selected_fco_id = local_assigns[:selected_fco_id] %>
<% to_options = local_assigns.fetch(:to_options, []) %>
<% selected_to_id = local_assigns[:selected_to_id] %>
<% allow_all_projects = local_assigns.fetch(:allow_all_projects, false) %>
<% download_path = local_assigns[:download_path] %>
<% project_ownership_lookup = local_assigns.fetch(:project_ownership_lookup, {}) || {} %>

<section class="page-header">
  <div>
    <p class="eyebrow">Workspace</p>
    <h1><%= page_title %></h1>
  </div>
  <div class="header-card">
    <span>No of Activity</span>
    <strong><%= rows.size %></strong>
  </div>
</section>

<section class="toolbar <%= "records-filter-toolbar" if download_path.present? %>">
  <%= form_with url: form_path, method: :get, class: "filter-form action-plan-filter-form" do |form| %>
    <label>
      <span class="filter-label">Choose Project</span>
      <% project_select_options = project_options.map { |project| [project, project] } %>
      <% project_select_options.unshift(["All Projects", "all"]) if allow_all_projects %>
      <%= form.select :project, options_for_select(project_select_options, selected_project), { prompt: "Select Project" }, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">FCO</span>
      <%= form.select :fco_id, options_for_select([["All FCO", ""]] + fco_options, selected_fco_id.to_s), {}, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">TO</span>
      <%= form.select :to_id, options_for_select([["All TO", ""]] + to_options, selected_to_id.to_s), {}, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>
  <% if download_path.present? %>
    <div class="toolbar-actions">
      <%= link_to "Download Excel Sheet", download_path, class: "secondary-button" %>
    </div>
  <% end %>
</section>

<% if selected_project.present? %>
  <% planned_total = rows.sum(&:planned_total) %>
  <% current_total = rows.sum(&:monthly_total) %>

  <section class="metric-grid metric-grid-compact">
    <% if selected_project == "all" %>
      <article class="metric metric-teal"><span>Projects</span><strong><%= rows.distinct.count(:project_name) %></strong></article>
    <% elsif show_admin_columns %>
      <article class="metric metric-teal"><span>PO ID</span><strong><%= rows.first&.po_id %></strong></article>
    <% else %>
      <article class="metric metric-teal"><span>Project ID</span><strong><%= rows.first&.project_id %></strong></article>
    <% end %>
    <article class="metric metric-blue"><span>Activities</span><strong><%= rows.size %></strong></article>
    <article class="metric"><span>Themes</span><strong><%= theme_count %></strong></article>
    <% if show_achievement %>
      <article class="metric metric-rose"><span>Achievement Total</span><strong><%= rows.sum(&:target_total) %></strong></article>
    <% end %>
  </section>

  <section class="table-panel submission-panel" data-searchable-table data-balance-panel>
    <div class="table-heading">
      <div>
        <h2><%= selected_project == "all" ? "All Projects" : selected_project %></h2>
        <% if show_admin_columns && project_ownership.present? %>
          <p class="muted">
            Project Owner:
            <%= [project_ownership.po_name, project_ownership.project_owner_id].compact_blank.join(" / ") %>
          </p>
        <% elsif local_assigns[:fco_view] %>
          <p class="muted">Your FCO targets for this project (view only).</p>
        <% end %>
      </div>
      <div class="table-actions">
        <input type="search" class="table-search" placeholder="Search activities" data-table-search-input>
        <span class="table-count" data-filtered-count data-count-label="activities"><%= rows.size %> activities</span>
      </div>
    </div>

    <% if show_submission && existing_submission.present? %>
      <%= render "action_plans/status_trail", submission: existing_submission %>
    <% end %>

    <% if editable_targets %>
      <div class="balance-bar <%= "is-unbalanced" if current_total != planned_total %>" data-balance-bar>
        <div class="balance-item">
          <span>Planned Total</span>
          <strong data-planned-total><%= planned_total %></strong>
        </div>
        <div class="balance-item">
          <span>Current Total</span>
          <strong data-current-total><%= current_total %></strong>
        </div>
        <div class="balance-item">
          <span>Difference</span>
          <strong data-difference-total><%= current_total - planned_total %></strong>
        </div>
        <p class="balance-note" data-balance-note>
          <%= current_total == planned_total ? "All activities match their planned total. Submit to record when ready." : "Monthly targets must add up to each activity's planned total before you can submit." %>
        </p>
      </div>
    <% end %>

    <% if editable_targets %>
      <% submit_locked = existing_submission&.approved? %>
      <%= form_with url: update_form_path, method: :patch, class: "action-plan-target-form" do |form| %>
        <%= hidden_field_tag :project, selected_project %>
        <%= hidden_field_tag :fco_id, selected_fco_id if selected_fco_id.present? %>
        <%= hidden_field_tag :to_id, selected_to_id if selected_to_id.present? %>
        <div class="responsive-table action-plan-table-wrap">
          <%= render "action_plans/table",
            rows: rows,
            project_ownership_lookup: project_ownership_lookup,
            show_admin_columns: show_admin_columns,
            editable_targets: true,
            show_achievement: show_achievement %>
        </div>
        <div class="submit-panel">
          <% if submit_with_targets && show_submission %>
            <div class="action-plan-submit-copy">
              <% if existing_submission&.approved? %>
                <p class="muted">This action plan is fully approved.</p>
              <% else %>
                <p class="muted">Targets will be saved and reflected in the record.</p>
              <% end %>
            </div>
            <%= form.submit "Submit to Record",
              name: "submit_to_record",
              class: "submit-plan-button",
              data: { submit_guard: true, locked_by_server: submit_locked.presence },
              disabled: submit_locked %>
          <% else %>
            <p class="muted">Redistribute the monthly targets for your vertical rows, then save.</p>
            <%= form.submit "Save Targets", class: "submit-plan-button" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="responsive-table action-plan-table-wrap">
        <%= render "action_plans/table",
          rows: rows,
          project_ownership_lookup: project_ownership_lookup,
          show_admin_columns: show_admin_columns,
          editable_targets: false,
          show_achievement: show_achievement %>
      </div>
    <% end %>
  </section>

  <% if show_submission && !submit_with_targets && !current_user.admin? %>
    <% submit_locked = balance_warning.present? || existing_submission&.approved? %>
    <%= form_with url: submit_path, method: :post, class: "table-panel action-plan-submit-form" do |form| %>
      <%= form.hidden_field :project_name, value: selected_project %>
      <div class="submit-panel">
        <div class="action-plan-submit-copy">
          <label class="filter-label" for="submission_remark">Remark</label>
          <%= form.text_area :submission_remark,
            id: "submission_remark",
            value: existing_submission&.submission_remark,
            class: "approval-remark",
            placeholder: "Add a note for the approvers (optional)",
            rows: 2 %>

          <% if balance_warning.present? %>
            <p class="balance-alert" data-submit-blocker><%= balance_warning %></p>
          <% elsif existing_submission&.approved? %>
            <p class="muted">This action plan is fully approved.</p>
          <% end %>
        </div>

        <%= form.submit existing_submission&.pending? ? "Resubmit for Approval" : "Submit for Approval",
          class: "submit-plan-button",
          data: { submit_guard: true, locked_by_server: submit_locked.presence },
          disabled: submit_locked %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <section class="empty-state">
    <h2>Select a project</h2>
    <p class="muted"><%= empty_message %></p>
  </section>
<% end %>
