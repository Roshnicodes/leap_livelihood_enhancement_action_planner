<% content_for :title, "Donor Report Upload | LEAP" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Reports</p>
    <h1>Donor Report Upload</h1>
    <p class="muted">Upload donor reports and keep them available for download by all users.</p>
  </div>
  <div class="header-card">
    <span>Reports</span>
    <strong><%= @uploads.size %></strong>
  </div>
</section>

<% if @can_upload_donor_report %>
  <section class="table-panel import-panel">
    <div class="table-heading">
      <div>
        <h2>Upload donor report</h2>
        <p class="muted">Choose project, reports name, frequency, submission date and file.</p>
      </div>
    </div>

    <%= form_with model: DonorReportUpload.new, url: donor_report_uploads_path, method: :post, multipart: true, class: "import-form pis-upload-form" do |form| %>
      <div class="import-grid pis-upload-grid">
        <label>
          <span>Project</span>
          <%= form.select :project_name,
            options_for_select(@project_options.map { |project| [project, project] }),
            { prompt: "Select Project" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>Reports Name</span>
          <%= form.collection_select :donor_report_type_id,
            @report_types,
            :id,
            :name,
            { prompt: "Select Reports Name" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>Frequency</span>
          <%= form.select :frequency,
            options_for_select(@frequency_options.map { |frequency| [frequency, frequency] }),
            { prompt: "Select Frequency" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>Submission Date</span>
          <%= form.date_field :submission_date, class: "input", required: true %>
        </label>

        <label>
          <span>Doc Upload</span>
          <%= form.file_field :document_file, class: "input", required: true %>
        </label>

        <label>
          <span>Email/Application Screenshot Upload</span>
          <%= form.file_field :screenshot_file, class: "input", required: true %>
        </label>
      </div>

      <div class="submit-panel">
        <p class="muted">Uploaded reports will be visible in Donor Report Record for all users.</p>
        <%= form.submit "Upload Donor Report", class: "submit-plan-button" %>
      </div>
    <% end %>
  </section>
<% end %>
