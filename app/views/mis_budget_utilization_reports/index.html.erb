<% content_for :title, "MIS Budget Utilization Report | LEAP" %>
<% filter_selected_project = params[:project].to_s.presence_in([ "all", *@project_options ]) %>
<% filter_selected_period = params[:period].to_s.presence_in(@period_options.map(&:last)) %>
<% filter_selected_period_month = params[:period_month].to_s.presence_in(BudgetUtilization::MONTH_KEYS) %>
<% filter_selected_vertical = params[:vertical].to_s.presence_in(@vertical_options) %>
<% filter_selected_office = params[:office].to_s.presence_in(@office_options) %>
<% filter_selected_user = params[:user].to_s.presence_in(@user_options) %>

<section class="page-header budget-utilization-header mis-budget-header">
  <div>
    <p class="eyebrow">MIS Workspace</p>
    <h1>MIS Budget Utilization Report</h1>
    <p class="muted">
      BLI-wise allocated budget, monthly allocated budget, and utilization.
      <% if @latest_month.present? %>
        Through <%= @latest_month.capitalize %>.
      <% end %>
    </p>
  </div>
  <div class="header-card">
    <span>Projects</span>
    <strong><%= @project_count %></strong>
  </div>
</section>

<section class="toolbar records-filter-toolbar mis-budget-filter-toolbar">
  <%= form_with url: mis_budget_utilization_reports_path, method: :get, class: "filter-form action-plan-filter-form" do |form| %>
    <label>
      <span class="filter-label">Choose Project</span>
      <% project_select_options = @project_options.map { |project| [ project, project ] } %>
      <% project_select_options.unshift([ "All Projects", "all" ]) %>
      <%= form.select :project, options_for_select(project_select_options, filter_selected_project), { prompt: "Select Project" }, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">Period</span>
      <%= form.select :period, options_for_select(@period_options, filter_selected_period), { prompt: "Select Period" }, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">Month</span>
      <%= form.select :period_month, options_for_select(BudgetUtilization::MONTH_KEYS.map { |month| [ month.capitalize, month ] }, filter_selected_period_month), { prompt: "Select Month" }, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">Vertical</span>
      <%= form.select :vertical, options_for_select([[ "All Vertical", "" ]] + @vertical_options.map { |vertical| [ vertical, vertical ] }, filter_selected_vertical.to_s), {}, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">Office</span>
      <%= form.select :office, options_for_select([[ "All Office", "" ]] + @office_options.map { |office| [ office, office ] }, filter_selected_office.to_s), {}, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>

    <label>
      <span class="filter-label">User</span>
      <%= form.select :user, options_for_select([[ "All User", "" ]] + @user_options.map { |user| [ user, user ] }, filter_selected_user.to_s), {}, class: "select", onchange: "this.form.requestSubmit()" %>
    </label>
  <% end %>
  <div class="toolbar-actions">
    <%= link_to "Download Excel Sheet", mis_budget_utilization_reports_path(request.query_parameters.merge(format: :xlsx)), class: "secondary-button" %>
  </div>
</section>

<% if @rows.any? %>
  <section class="metric-grid metric-grid-compact budget-utilization-metrics mis-budget-metrics">
    <article class="metric metric-teal"><span>No of BLI Rows</span><strong><%= @rows.size %></strong></article>
    <article class="metric metric-ink"><span>No of Project</span><strong><%= @project_count %></strong></article>
    <article class="metric"><span>Total Allocated Budget</span><strong><%= currency(@period_allocated_total) %></strong></article>
    <article class="metric metric-blue"><span>Total Expenditure</span><strong><%= currency(@expenditure_total) %></strong></article>
    <article class="metric metric-rose"><span>Total Remaining Budget</span><strong><%= currency(@remaining_total) %></strong></article>
  </section>

  <div class="table-panel budget-utilization-panel mis-budget-panel" data-searchable-table="true">
    <div class="table-heading">
      <div>
        <p class="eyebrow">MIS Utilization Report</p>
        <h2>BLI-wise utilization</h2>
        <p class="muted">Months: <%= @months.map(&:capitalize).join(", ") %></p>
      </div>
      <div class="table-actions">
        <input type="search" class="table-search" placeholder="Search BLI rows" data-table-search-input>
        <span class="table-count" data-filtered-count data-count-label="rows"><%= @rows.size %> rows</span>
      </div>
    </div>

    <div class="responsive-table budget-utilization-table-wrap mis-budget-table-wrap">
      <table class="budget-utilization-table budget-report-table mis-budget-table">
        <thead>
          <tr>
            <th>S.No.</th>
            <th>Project Name</th>
            <th>Project BLI Name</th>
            <th>BLI Code</th>
            <th>BLI Allocated Fund</th>
            <th>Financial Year</th>
            <th>Office Name</th>
            <th>Vertical</th>
            <th>Activity</th>
            <th>Responsible Users</th>
            <th>Total Expenditure</th>
            <th>Total Remaining Budget</th>
            <% @months.each do |month| %>
              <th class="month-allocation-heading"><%= month.capitalize %> Month Allocated Budget</th>
              <th class="month-utilized-heading"><%= month.capitalize %> Expenses</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @rows.each_with_index do |row, index| %>
            <tr>
              <td><span class="code-pill"><%= index + 1 %></span></td>
              <td><strong><%= row[:project_name].presence || "-" %></strong></td>
              <td><%= row[:project_bli_name].presence || "-" %></td>
              <td><span class="code-pill"><%= row[:bli_code].presence || "-" %></span></td>
              <td class="money-cell"><%= currency(row[:allocated_fund]) %></td>
              <td><%= row[:financial_year].presence || "-" %></td>
              <td><%= row[:office_name].presence || "-" %></td>
              <td><%= row[:vertical_name].presence || "-" %></td>
              <td><%= row[:activity_name].presence || "-" %></td>
              <td><%= row[:responsible_user_name].presence || "-" %></td>
              <td class="money-cell"><%= currency(row[:total_expenditure]) %></td>
              <td class="money-cell"><%= currency(row[:total_remaining]) %></td>
              <% @months.each do |month| %>
                <td class="money-cell month-allocation-cell"><%= currency(row[:month_allocated][month]) %></td>
                <td class="money-cell month-utilized-cell"><%= currency(row[:month_utilized][month]) %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <section class="empty-state">
    <h2>No utilization saved</h2>
    <p class="muted">Accounts has not saved utilization yet. MIS report will appear after entries are saved.</p>
  </section>
<% end %>
