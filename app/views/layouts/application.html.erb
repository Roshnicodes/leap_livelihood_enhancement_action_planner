        <% end %>
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/file_preview_modal" %>

    <script>
      (() => {
        function bindSearch(panel) {
          const input = panel.querySelector("[data-table-search-input]");
          const rows = [...panel.querySelectorAll("tbody tr")];
          const count = panel.querySelector("[data-filtered-count]");
          if (!input || rows.length === 0) return;

          input.addEventListener("input", () => {
            const term = input.value.trim().toLowerCase();
            let visible = 0;

            rows.forEach((row) => {
              const match = row.textContent.toLowerCase().includes(term);
              row.hidden = !match;
              if (match) visible += 1;
            });

            if (count) {
              const label = count.dataset.countLabel || "rows";
              count.textContent = `${visible} ${label}`;
            }
          });
        }

        document.querySelectorAll("[data-searchable-table]").forEach(bindSearch);

        function bindCollapsiblePanel(panel) {
          const toggle = panel.querySelector("[data-collapsible-toggle]");
          const content = panel.querySelector("[data-collapsible-content]");
          if (!toggle || !content) return;

          const showLabel = toggle.dataset.showLabel || "Show";
          const hideLabel = toggle.dataset.hideLabel || "Hide";

          function setOpen(open) {
            panel.classList.toggle("is-collapsed", !open);
            content.hidden = !open;
            toggle.textContent = open ? hideLabel : showLabel;
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
          }

          setOpen(panel.dataset.collapsed !== "true");

          toggle.addEventListener("click", () => {
            setOpen(content.hidden);
          });
        }

        document.querySelectorAll("[data-collapsible-panel]").forEach(bindCollapsiblePanel);

        function bindTargetBalance(panel) {
          const bar = panel.querySelector("[data-balance-bar]");
          const targetRows = [...panel.querySelectorAll("[data-plan-row]")];
          if (!bar || targetRows.length === 0) return;

          const plannedEl = bar.querySelector("[data-planned-total]");
          const currentEl = bar.querySelector("[data-current-total]");
          const diffEl = bar.querySelector("[data-difference-total]");
          const noteEl = bar.querySelector("[data-balance-note]");
          const submit = document.querySelector("[data-submit-guard]");

          function refresh() {
            let planned = 0;
            let current = 0;

            targetRows.forEach((row) => {
              const rowPlanned = Number(row.dataset.plannedTotal || 0);
              const rowTotal = [...row.querySelectorAll("[data-target-input]")]
                .reduce((sum, input) => sum + (Number(input.value) || 0), 0);

              planned += rowPlanned;
              current += rowTotal;

              const totalEl = row.querySelector("[data-row-total]");
              const statusEl = row.querySelector("[data-row-status]");
              if (totalEl) totalEl.textContent = rowTotal;

              if (statusEl) {
                const rowDifference = rowTotal - rowPlanned;
                const rowMatched = rowDifference === 0;
                statusEl.classList.toggle("is-balanced", rowMatched);
                statusEl.classList.toggle("is-warning", !rowMatched);
                statusEl.textContent = rowMatched
                  ? "Matched"
                  : `Diff ${rowDifference > 0 ? "+" : ""}${rowDifference}`;
              }
            });

            const difference = current - planned;
            const balanced = difference === 0;

            if (plannedEl) plannedEl.textContent = planned;
            if (currentEl) currentEl.textContent = current;
            if (diffEl) diffEl.textContent = difference > 0 ? `+${difference}` : difference;
            bar.classList.toggle("is-unbalanced", !balanced);

            if (noteEl) {
              noteEl.textContent = balanced
                ? "All activities match their planned total. Submit to record when ready."
                : "Monthly targets must add up to each activity's planned total before you can submit.";
            }

            if (submit && !submit.dataset.lockedByServer) {
              submit.disabled = !balanced;
            }
          }

          panel.addEventListener("input", (event) => {
            if (event.target.matches("[data-target-input]")) refresh();
          });

          refresh();
        }

        document.querySelectorAll("[data-balance-panel]").forEach(bindTargetBalance);

        function bindSidebarSections(nav) {
          const sections = [...nav.querySelectorAll("[data-sidebar-section]")];
          if (sections.length === 0) return;

          const storageKey = "leap.sidebar.sections";
          try {
            localStorage.removeItem(storageKey);
          } catch (_error) {
            // Ignore storage failures (private mode, quota, etc).
          }

          function setSectionOpen(section, open) {
            const toggle = section.querySelector("[data-sidebar-toggle]");
            section.classList.toggle("is-open", open);
            if (toggle) toggle.setAttribute("aria-expanded", open ? "true" : "false");
          }

          const activeSection = sections.find((section) => section.querySelector(".side-link.active"));

          sections.forEach((section) => {
            const toggle = section.querySelector("[data-sidebar-toggle]");
            if (!toggle) return;

            setSectionOpen(section, activeSection ? section === activeSection : section.classList.contains("is-open"));

            toggle.addEventListener("click", () => {
              const willOpen = !section.classList.contains("is-open");
              sections.forEach((otherSection) => setSectionOpen(otherSection, false));
              setSectionOpen(section, willOpen);
            });
          });

          const activeLink = nav.querySelector(".side-link.active");
          activeLink?.scrollIntoView({ block: "nearest", inline: "nearest" });
        }

        document.querySelectorAll("[data-sidebar-nav]").forEach(bindSidebarSections);

        function bindFilterPlaceholders() {
          const labelOverrides = new Map([
            ["choose project", "Project"],
            ["project", "Project"],
            ["choose month", "Month"],
            ["month", "Month"],
            ["period", "Period"],
            ["state", "State"],
            ["vertical", "Vertical"],
            ["fco", "FCO"],
            ["to", "TO"],
            ["choose to", "TO"],
            ["status", "Status"],
            ["fy", "FY"],
            ["doc name", "Doc Name"],
            ["reports name", "Report"],
            ["frequency", "Frequency"],
            ["employee", "Employee"],
            ["p&b vertical", "Vertical"]
          ]);

          function placeholderFor(select) {
            const label = select.closest("label")?.querySelector(".filter-label") ||
              select.closest(".approval-records-filter-field")?.querySelector(".filter-label") ||
              document.querySelector(`label[for="${select.id}"]`);
            const rawText = (label?.textContent || select.name || "Option").trim().toLowerCase();
            const cleaned = rawText.replace(/\s+/g, " ");
            return `Select ${labelOverrides.get(cleaned) || cleaned.replace(/^choose\s+/, "").replace(/\b\w/g, (char) => char.toUpperCase())}`;
          }

          document.querySelectorAll(".toolbar select.select, .filter-form select.select").forEach((select) => {
            const options = [...select.options];
            const firstBlankOption = options.find((option) => option.value === "");
            if (!firstBlankOption) return;

            const placeholderText = placeholderFor(select);
            const firstBlankText = firstBlankOption.textContent.trim().toLowerCase();
            const hasSelectPlaceholder = firstBlankText.startsWith("select ");
            const paramName = select.name;
            const params = new URLSearchParams(window.location.search);
            const placeholderValue = `__placeholder_${paramName || "filter"}__`;

            if (!hasSelectPlaceholder && !options.some((option) => option.value === placeholderValue)) {
              const placeholderOption = new Option(placeholderText, placeholderValue, true, !params.has(paramName));
              placeholderOption.disabled = true;
              select.insertBefore(placeholderOption, firstBlankOption);
            } else if (hasSelectPlaceholder) {
              firstBlankOption.textContent = placeholderText;
            }

            select.classList.toggle("is-placeholder", select.value === placeholderValue || (hasSelectPlaceholder && select.value === ""));
            select.addEventListener("change", () => {
              select.classList.toggle("is-placeholder", select.value === placeholderValue || (hasSelectPlaceholder && select.value === ""));
            });
          });

          document.querySelectorAll("form").forEach((form) => {
            form.addEventListener("submit", () => {
              form.querySelectorAll("select.select").forEach((select) => {
                if (!select.value.startsWith("__placeholder_")) return;

                const allOption = [...select.options].find((option) => option.value === "");
                if (allOption) select.value = "";
              });
            });
          });
        }

        bindFilterPlaceholders();

        function bindPeriodMonthFilters() {
          document.querySelectorAll("form").forEach((form) => {
            const periodSelect = form.querySelector('select[name="period"]');
            const monthSelect = form.querySelector('select[name="period_month"]');
            if (!periodSelect || !monthSelect) return;

            monthSelect.addEventListener("change", () => {
              if (monthSelect.value && periodSelect.querySelector('option[value="monthly"]')) {
                periodSelect.value = "monthly";
              }
            }, true);
          });
        }

        bindPeriodMonthFilters();

        function bindFilePreview() {
          const modal = document.querySelector("[data-file-preview-modal]");
          if (!modal) return;

          const title = modal.querySelector("[data-file-preview-title]");
          const body = modal.querySelector("[data-file-preview-body]");
          const download = modal.querySelector("[data-file-preview-download]");

          function closePreview() {
            modal.classList.add("is-hidden");
            modal.setAttribute("aria-hidden", "true");
            if (body) body.innerHTML = "";
          }

          function openPreview(trigger) {
            const type = trigger.dataset.previewType || "file";
            const url = trigger.dataset.previewUrl;
            const downloadUrl = trigger.dataset.previewDownload || url;
            const name = trigger.dataset.previewName || "File preview";
            if (!url || !body) return;

            // Non-previewable types open directly in a new tab / download.
            if (type === "file") {
              window.open(downloadUrl || url, "_blank", "noopener");
              return;
            }

            if (title) title.textContent = name;
            if (download) download.href = downloadUrl;

            body.innerHTML = "";
            if (type === "image") {
              const img = document.createElement("img");
              img.src = url;
              img.alt = name;
              img.className = "file-preview-image";
              body.appendChild(img);
            } else if (type === "pdf") {
              const frame = document.createElement("iframe");
              frame.src = url;
              frame.title = name;
              frame.className = "file-preview-frame";
              body.appendChild(frame);
            } else if (type === "video") {
              const video = document.createElement("video");
              video.src = url;
              video.controls = true;
              video.className = "file-preview-media";
              body.appendChild(video);
            } else if (type === "audio") {
              const audio = document.createElement("audio");
              audio.src = url;
              audio.controls = true;
              audio.className = "file-preview-media";
              body.appendChild(audio);
            }

            modal.classList.remove("is-hidden");
            modal.setAttribute("aria-hidden", "false");
          }

          document.addEventListener("click", (event) => {
            const trigger = event.target.closest("[data-file-preview]");
            if (trigger) {
              event.preventDefault();
              openPreview(trigger);
              return;
            }

            if (event.target.closest("[data-close-file-preview]")) {
              closePreview();
            }
          });

          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !modal.classList.contains("is-hidden")) {
              closePreview();
            }
          });
        }

        bindFilePreview();

        function previewTypeForFile(file) {
          if (file.type.startsWith("image/")) return "image";
          if (file.type === "application/pdf" || /\.pdf$/i.test(file.name)) return "pdf";
          if (file.type.startsWith("video/")) return "video";
          if (file.type.startsWith("audio/")) return "audio";
          return "file";
        }

        function bindLocalFilePreviews() {
          document.querySelectorAll("[data-local-file-input]").forEach((input) => {
            input.addEventListener("change", () => {
              const stack = input.closest("[data-file-stack]");
              const host = stack?.querySelector("[data-local-file-previews]");
              if (!host) return;

              host.innerHTML = "";
              [...(input.files || [])].forEach((file) => {
                const objectUrl = URL.createObjectURL(file);
                const type = previewTypeForFile(file);
                const item = document.createElement("div");
                item.className = "achievement-local-preview-item is-clickable";

                const trigger = document.createElement("button");
                trigger.type = "button";
                trigger.className = type === "image" ? "achievement-file-thumb-button" : "achievement-file-type-badge";
                trigger.dataset.filePreview = "";
                trigger.dataset.previewType = type;
                trigger.dataset.previewUrl = objectUrl;
                trigger.dataset.previewDownload = objectUrl;
                trigger.dataset.previewName = file.name;
                trigger.title = "Click to open";

                if (type === "image") {
                  const img = document.createElement("img");
                  img.alt = file.name;
                  img.src = objectUrl;
                  img.className = "achievement-file-thumb";
                  trigger.appendChild(img);
                } else {
                  const ext = (file.name.split(".").pop() || "FILE").toUpperCase();
                  trigger.textContent = type === "pdf" ? "PDF" : ext.slice(0, 4);
                }

                const meta = document.createElement("div");
                meta.className = "achievement-file-meta";

                const nameBtn = document.createElement("button");
                nameBtn.type = "button";
                nameBtn.className = "achievement-file-link";
                nameBtn.dataset.filePreview = "";
                nameBtn.dataset.previewType = type;
                nameBtn.dataset.previewUrl = objectUrl;
                nameBtn.dataset.previewDownload = objectUrl;
                nameBtn.dataset.previewName = file.name;
                nameBtn.textContent = file.name;

                const hint = document.createElement("div");
                hint.className = "achievement-local-preview-name";
                hint.textContent = "Click to open • Save Draft to keep";

                meta.appendChild(nameBtn);
                meta.appendChild(hint);
                item.appendChild(trigger);
                item.appendChild(meta);
                host.appendChild(item);
              });
            });
          });
        }

        bindLocalFilePreviews();
      })();
    </script>
  </body>
</html>
