<% content_for :title, "PIS Report Upload | LEAP" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Reports</p>
    <h1>PIS Report Upload</h1>
    <p class="muted">Upload project documents once and keep them available for download by all users.</p>
  </div>
  <div class="header-card">
    <span>Documents</span>
    <strong><%= @documents.size %></strong>
  </div>
</section>

<% if @can_upload_pis_report %>
  <section class="table-panel import-panel">
    <div class="table-heading">
      <div>
        <h2>Upload document</h2>
        <p class="muted">Choose project, document name, financial year, submission date and file.</p>
      </div>
    </div>

    <%= form_with model: PisReportDocument.new, url: pis_report_uploads_path, method: :post, multipart: true, class: "import-form pis-upload-form" do |form| %>
      <div class="import-grid pis-upload-grid">
        <label>
          <span>Project</span>
          <%= form.select :project_name,
            options_for_select(@project_options.map { |project| [project, project] }),
            { prompt: "Select Project" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>Doc Name</span>
          <%= form.collection_select :pis_document_type_id,
            @document_types,
            :id,
            :name,
            { prompt: "Select Doc Name" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>FY</span>
          <%= form.select :financial_year,
            options_for_select(@financial_year_options.map { |year| [year, year] }, PisReportDocument.financial_year_for),
            { prompt: "Select FY" },
            class: "select",
            required: true %>
        </label>

        <label>
          <span>Submission / Receipt Date</span>
          <%= form.date_field :submission_date, class: "input", required: true %>
        </label>

        <label>
          <span>Document Upload</span>
          <%= form.file_field :file, class: "input", required: true %>
        </label>

        <label>
          <span>Email/Application Screenshot Upload</span>
          <%= form.file_field :screenshot_file, class: "input", required: true %>
        </label>
      </div>

      <div class="submit-panel">
        <p class="muted">Uploaded documents will be visible in PIS Report Record for all users.</p>
        <%= form.submit "Upload Document", class: "submit-plan-button" %>
      </div>
    <% end %>
  </section>
<% end %>
