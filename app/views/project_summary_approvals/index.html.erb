<% content_for :title, "Project Summary Approval | LEAP Planner" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Approval</p>
    <h1>Project Summary Approval</h1>
  </div>
  <div class="header-card">
    <span>Pending</span>
    <strong><%= @pending_group_count %></strong>
  </div>
</section>

<% can_approve = current_user.admin? || ProjectSummarySubmission.summary_approver?(current_user.employee) %>

<section class="toolbar approval-filter-toolbar">
  <%= form_with url: project_summary_approvals_path, method: :get, class: "filter-form" do |form| %>
    <% vertical_select_options = [["Select Vertical", ""]] + @vertical_options.map { |vertical| [vertical, vertical] } %>
    <%= form.label :vertical, "Choose Vertical", class: "filter-label" %>
    <%= form.select :vertical, options_for_select(vertical_select_options, @selected_vertical), {}, class: "select", onchange: "this.form.requestSubmit()" %>
  <% end %>
</section>

<% if @selected_vertical.blank? %>
  <section class="empty-state vertical-select-state">
    <h2>Select a vertical</h2>
  </section>
<% elsif @summary_rows.any? %>
  <section class="approval-overview-bar">
    <div class="approval-overview-copy">
      <p class="eyebrow">Pending Approval</p>
      <h2 class="approval-vertical-title"><%= @selected_vertical %></h2>
    </div>
    <div class="approval-total-hero">
      <span>All Project Total</span>
      <strong><%= currency(@overall_total) %></strong>
    </div>
  </section>

  <section class="approval-project-records">
    <div class="approval-section-heading">
      <div>
        <p class="eyebrow">Project Records</p>
        <h3>Project-wise approval detail</h3>
      </div>
      <span><%= @project_record_groups.size %> projects</span>
    </div>

    <% @project_record_groups.each do |project| %>
      <section class="table-panel submission-panel">
        <div class="table-heading">
          <div>
            <h2><%= project[:project_name] %></h2>
            <p class="muted">
              <%= project[:employee_names].join(" • ") %>
            </p>
          </div>
          <div class="approval-project-total">
            <div>
              <span>Project Total</span>
              <strong><%= currency(project[:total_amount]) %></strong>
            </div>
          </div>
        </div>

        <div class="responsive-table">
          <table>
            <thead>
              <tr>
                <th>S.No.</th>
                <th>Project</th>
                <th>ASA Activity</th>
                <th>Project PNB</th>
                <th>Total Amount</th>
                <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
                  <th><%= month.to_s.titleize %></th>
                <% end %>
                <th>Changed Total</th>
                <th>Remark</th>
              </tr>
            </thead>
            <tbody>
              <% project[:rows].each_with_index do |row, index| %>
                <% changed_months = row[:month_deltas].select { |_month, delta| delta.abs >= 0.01 } %>
                <tr>
                  <td><span class="code-pill"><%= index + 1 %></span></td>
                  <td><%= row[:project_name].presence || "-" %></td>
                  <td><%= row[:activity_name] %></td>
                  <td><%= row[:vertical_name] %></td>
                  <td class="money-cell"><%= currency(row[:total_amount]) %></td>
                  <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
                    <% delta = row[:month_deltas][month] %>
                    <td class="money-cell <%= "is-edited-cell" if changed_months.key?(month) %>">
                      <%= currency(row[:month_amounts][month]) %>
                      <% if delta.abs >= 0.01 %>
                        <span class="cell-change-value">
                          Changes <%= delta.positive? ? "+" : "" %><%= currency(delta) %>
                        </span>
                      <% end %>
                    </td>
                  <% end %>
                  <td class="money-cell"><%= currency(row[:changed_total]) %></td>
                  <td><%= row[:remark].presence || "-" %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="summary-total-row">
                <td><span class="code-pill">Total</span></td>
                <td colspan="3"><strong><%= project[:project_name] %> Total</strong></td>
                <td class="money-cell"><%= currency(project[:total_amount]) %></td>
                <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
                  <td class="money-cell"><%= currency(project[:month_totals][month]) %></td>
                <% end %>
                <td class="money-cell"><%= currency(project[:total_amount]) %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    <% end %>
  </section>

  <section class="overall-summary-panel">
    <div class="overall-summary-heading">
      <div>
        <p class="eyebrow">Overall Summary</p>
        <h2><%= @selected_vertical %> Summary</h2>
      </div>
      <strong><%= currency(@overall_total) %></strong>
    </div>

    <div class="responsive-table activity-summary-table">
      <table>
        <thead>
          <tr>
            <th>S.No.</th>
            <th>Project BLI code</th>
            <th>ASA Activity</th>
            <th>Project Count</th>
            <th>Total Amount</th>
            <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
              <th><%= month.to_s.titleize %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @activity_summaries.each_with_index do |activity, index| %>
            <% modal_id = "approval-activity-projects-#{index}" %>
            <tr>
              <td><span class="code-pill"><%= index + 1 %></span></td>
              <td><span class="code-pill"><%= activity[:bli_code].presence || "-" %></span></td>
              <td><strong><%= activity[:activity_name] %></strong></td>
              <td>
                <button type="button" class="project-count-badge" data-open-activity-modal="<%= modal_id %>">
                  <%= activity[:project_count] %>
                </button>
              </td>
              <td class="money-cell"><%= currency(activity[:total_amount]) %></td>
              <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
                <% change_labels = activity[:month_changes][month].map { |delta| "#{delta.positive? ? "+" : ""}#{currency(delta)}" }.uniq %>
                <td class="money-cell <%= "is-edited-cell" if change_labels.any? %>">
                  <%= currency(activity[:month_totals][month]) %>
                  <% if change_labels.any? %>
                    <span class="cell-change-value">
                      Changes <%= change_labels.join(" / ") %>
                    </span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
          <tr class="summary-total-row">
            <td><span class="code-pill">Total</span></td>
            <td>-</td>
            <td><strong>All Project Total</strong></td>
            <td>
              <span class="project-count-badge"><%= @summary_project_count %></span>
            </td>
            <td class="money-cell"><%= currency(@overall_total) %></td>
            <% VerticalPercent::MONTH_COLUMNS.each do |month| %>
              <% change_labels = @overall_month_changes[month].map { |delta| "#{delta.positive? ? "+" : ""}#{currency(delta)}" }.uniq %>
              <td class="money-cell <%= "is-edited-cell" if change_labels.any? %>">
                <%= currency(@overall_month_totals[month]) %>
                <% if change_labels.any? %>
                  <span class="cell-change-value">
                    Changes <%= change_labels.join(" / ") %>
                  </span>
                <% end %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <% @activity_summaries.each_with_index do |activity, index| %>
    <% modal_id = "approval-activity-projects-#{index}" %>
    <section id="<%= modal_id %>" class="activity-modal is-hidden" data-activity-modal aria-hidden="true">
      <div class="activity-modal-backdrop" data-close-activity-modal></div>
      <div class="activity-modal-panel" role="dialog" aria-modal="true" aria-labelledby="<%= modal_id %>-title">
        <div class="activity-modal-heading">
          <div>
            <p class="eyebrow">Activity Projects</p>
            <h2 id="<%= modal_id %>-title"><%= activity[:activity_name] %></h2>
          </div>
          <button type="button" class="modal-close-button" data-close-activity-modal aria-label="Close projects">×</button>
        </div>
        <div class="responsive-table modal-table">
          <table>
            <thead>
              <tr>
                <th>S.No.</th>
                <th>Project Name</th>
                <th>Total Amount</th>
              </tr>
            </thead>
            <tbody>
              <% activity[:projects].each_with_index do |project, project_index| %>
                <tr>
                  <td><span class="code-pill"><%= project_index + 1 %></span></td>
                  <td><strong><%= project[:project_name] %></strong></td>
                  <td class="money-cell"><%= currency(project[:total_amount]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>

  <% if @pending_submissions.any? && can_approve %>
    <div class="approval-action-panel" data-approval-action-panel>
      <%= text_field_tag :shared_approval_remark, nil, class: "remark-input approval-remark shared-approval-remark", placeholder: "Remark", data: { shared_approval_remark: true } %>
      <div class="approval-action-forms">
        <%= form_with url: bulk_approve_project_summaries_path, method: :patch, class: "approval-form approval-bulk-form" do %>
          <%= hidden_field_tag :vertical, @selected_vertical %>
          <% @pending_submissions.each do |submission| %>
            <%= hidden_field_tag "submission_ids[]", submission.id %>
          <% end %>
          <%= hidden_field_tag :approval_remark, nil, data: { approval_remark_target: true } %>
          <button type="submit" class="submit-plan-button">Approve</button>
        <% end %>

        <%= form_with url: bulk_return_project_summaries_path, method: :patch, class: "approval-form approval-bulk-form" do %>
          <%= hidden_field_tag :vertical, @selected_vertical %>
          <% @pending_submissions.each do |submission| %>
            <%= hidden_field_tag "submission_ids[]", submission.id %>
          <% end %>
          <%= hidden_field_tag :approval_remark, nil, data: { approval_remark_target: true } %>
          <button type="submit" class="return-button">Return</button>
        <% end %>
      </div>
    </div>
  <% elsif @pending_submissions.any? %>
    <section class="approval-note">
      <span>View Only</span>
      <p>You can review the summary, but approval actions are restricted to the approver.</p>
    </section>
  <% end %>
<% else %>
  <section class="empty-state">
    <h2>No approval requests for <%= @selected_vertical %></h2>
  </section>
<% end %>

<script>
  (() => {
    const sharedRemark = document.querySelector("[data-shared-approval-remark]");
    const remarkTargets = [...document.querySelectorAll("[data-approval-remark-target]")];

    function syncApprovalRemark() {
      remarkTargets.forEach((target) => {
        target.value = sharedRemark?.value || "";
      });
    }

    sharedRemark?.addEventListener("input", syncApprovalRemark);
    document.querySelectorAll("[data-approval-action-panel] form").forEach((form) => {
      form.addEventListener("submit", syncApprovalRemark);
    });

    function closeActivityModals() {
      document.querySelectorAll("[data-activity-modal]").forEach((modal) => {
        modal.classList.add("is-hidden");
        modal.setAttribute("aria-hidden", "true");
      });
    }

    document.querySelectorAll("[data-open-activity-modal]").forEach((button) => {
      button.addEventListener("click", () => {
        const modal = document.getElementById(button.dataset.openActivityModal);
        if (!modal) return;

        closeActivityModals();
        modal.classList.remove("is-hidden");
        modal.setAttribute("aria-hidden", "false");
      });
    });

    document.querySelectorAll("[data-close-activity-modal]").forEach((button) => {
      button.addEventListener("click", closeActivityModals);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeActivityModals();
    });
  })();
</script>
